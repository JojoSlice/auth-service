# Server Configuration
HOST=127.0.0.1
PORT=3000
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite://data/bibblo.db

# JWT Configuration (Generate ECDSA P-256 key pair)
# To generate keys, run:
#   openssl ecparam -name prime256v1 -genkey -noout -out private-key.pem
#   openssl ec -in private-key.pem -pubout -out public-key.pem
#   cat private-key.pem | base64 -w0
#   cat public-key.pem | base64 -w0
JWT_PRIVATE_KEY=<base64-encoded-ECDSA-P256-private-key>
JWT_PUBLIC_KEY=<base64-encoded-ECDSA-P256-public-key>
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30
JWT_ISSUER=https://auth.yourdomain.com

# Google OAuth (Get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

# GitHub OAuth (Get from https://github.com/settings/developers)
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/github/callback

# Security
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<base64-encoded-32-byte-key>
API_KEY_SALT=<random-salt-string>

# Rate Limiting
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_OAUTH_INIT_PER_MINUTE=10

# Logging
RUST_LOG=info,bibblo=debug
LOG_FORMAT=pretty

# CORS (comma-separated list of allowed origins)
DEFAULT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# IP Filtering
ENABLE_IP_WHITELIST=false
ADMIN_IP_WHITELIST=127.0.0.1,::1
